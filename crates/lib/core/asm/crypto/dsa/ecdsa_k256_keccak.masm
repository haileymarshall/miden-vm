use miden::precompiles::crypto::dsa::ecdsa_secp256k1
use miden::core::crypto::hashes::keccak256
use miden::core::crypto::hashes::poseidon2

# ENCODING CONVENTIONS
# ================================================================================================
#
# - Native secp256k1 values are stored as little-endian numeric u32 limbs, one limb per Felt.
# - Compressed SEC1 public keys are encoded as `prefix || x_be`, where `prefix = 2 + (QY0 & 1)`,
#   then packed into 9 little-endian packed-u32 felts.
# - The public-key commitment is `Poseidon2::hash_elements(QX[8] || QY[8])` over the native
#   coordinate limbs in advice/memory order.
# - MSG is a word whose four felts are split into eight little-endian u32 limbs before Keccak256.

# PROCEDURES
# ================================================================================================

#! Verifies a secp256k1 ECDSA signature using the `miden-crypto::ecdsa_k256_keccak` message format.
#!
#! Inputs:
#!   Operand stack: [PK_COMM, MSG, ...]
#!   Advice stack:  [QX[8] | QY[8] | SIG_R[8] | SIG_S[8] | ...]
#! Outputs:
#!   Operand stack: [...]
#!   Advice stack:  [...]
#!
#! Where:
#! - `PK_COMM`: Poseidon2 hash commitment of `QX[8] || QY[8]`, where coordinates are native
#!   little-endian numeric u32 limbs, one limb per Felt.
#! - `MSG`: single word / 4 felts representing the 32-byte message to verify.
#! - `QX[8]`, `QY[8]`: native public-key coordinates as little-endian u32 limbs.
#! - `SIG_R[8]`, `SIG_S[8]`: native signature scalars as little-endian u32 limbs.
#!
#! Local memory layout (element addresses):
#!   - loc[0 ..16] : native public key, QX[8] || QY[8]. Required by
#!                   `ecdsa_secp256k1::assert_verify_prehash(pubkey_ptr, digest_ptr, sig_ptr)`.
#!   - loc[16..32] : native signature, SIG_R[8] || SIG_S[8]. Required by the same precompile ABI.
#!   - loc[32..40] : Keccak256(MSG) digest/prehash buffer passed as `digest_ptr`.
#!
#! The 40 local elements are the minimal contiguous memory ABI needed for the raw verifier call:
#! public key (16) + signature (16) + prehash output (8).
#!
#! Advice is untrusted. The wrapper binds QX/QY to `PK_COMM`, and the native verifier binds and
#! validates the public key, reduced prehash, and signature scalars through precompile-backed
#! deferred evaluation.
@locals(40)
pub proc verify
    # Load QX || QY from advice into the precompile public-key buffer while absorbing the same
    # two chunks into the Poseidon2 `hash_elements` state. Since there are exactly 16 elements,
    # the `hash_elements` capacity word is zero and no partial-block padding is required.
    # `adv_pipe` exposes each just-written chunk in the rate slots in the same order that
    # `mem_stream` would read it back from memory.
    locaddr.0 padw padw padw
    # => [R0=0w, R1=0w, C=0w, write_ptr=loc[0], PK_COMM, MSG, ...]
    adv_pipe
    # => [QX_RATE[8], C=0w, write_ptr=loc[8], PK_COMM, MSG, ...]
    hperm
    # => [R0, R1, C, write_ptr=loc[8], PK_COMM, MSG, ...]
    adv_pipe
    # => [QY_RATE[8], C, write_ptr=loc[16], PK_COMM, MSG, ...]
    hperm
    # => [R0, R1, C, write_ptr=loc[16], PK_COMM, MSG, ...]
    # Assert Poseidon2::hash_elements(QX[8] || QY[8]) == PK_COMM.
    exec.poseidon2::squeeze_digest
    # => [PK_HASH, write_ptr=loc[16], PK_COMM, MSG, ...]
    movup.4 drop
    # => [PK_HASH, PK_COMM, MSG, ...]
    assert_eqw.err="invalid public key commitment"
    # => [MSG, ...]

    # Load SIG_R || SIG_S from advice into the precompile signature buffer.
    locaddr.16 padw padw padw
    # => [R0=0w, R1=0w, C=0w, write_ptr=loc[16], MSG, ...]
    adv_pipe
    # => [SIG_R_RATE[8], C=0w, write_ptr=loc[24], MSG, ...]
    adv_pipe
    # => [SIG_S_RATE[8], C=0w, write_ptr=loc[32], MSG, ...]
    dropw dropw dropw drop
    # => [MSG, ...]

    # Keccak256(MSG[32]) -> loc[32..40], then convert the digest bytes into the native little-endian
    # scalar limbs expected by `assert_verify_prehash` in-place.
    exec.split_word_u32s_le
    # => [MSG_U32[8], ...]
    exec.keccak256::hash
    # => [DIGEST_U32[8], ...]
    loc_storew_le.32 dropw
    loc_storew_le.36 dropw
    # => [...]  (DIGEST_U32[8] written to loc[32..40])

    locaddr.32
    # => [read_ptr=loc[32], ...]
    repeat.8
        dup mem_load
        exec.reverse_u32_bytes
        swap add.1
    end
    # => [read_ptr=loc[40], PREHASH_U32[8], ...]
    drop
    # => [PREHASH_U32[8], ...] where PREHASH[0] = byte_reverse(KeccakDigest[7])
    locaddr.32 mem_storew_le dropw
    locaddr.36 mem_storew_le dropw
    # => [...]

    locaddr.16 locaddr.32 locaddr.0
    # => [pubkey_ptr, digest_ptr, sig_ptr, ...]
    exec.ecdsa_secp256k1::assert_verify_prehash
    # => [...]
end

#! Verifies a secp256k1 ECDSA signature over a pre-hashed message.
#!
#! Input:  [pubkey_ptr, digest_ptr, sig_ptr, ...]
#! Output: [...]
#!
#! Memory:
#! - `pubkey_ptr[0..8]`: QX as little-endian u32 limbs.
#! - `pubkey_ptr[8..16]`: QY as little-endian u32 limbs.
#! - `digest_ptr[0..8]`: raw prehash z as little-endian u32 limbs.
#! - `sig_ptr[0..8]`: SIG_R as little-endian u32 limbs.
#! - `sig_ptr[8..16]`: SIG_S as little-endian u32 limbs.
#!
#! No result word is pushed. The procedure traps on malformed native limbs, invalid/off-curve public
#! keys, invalid signature scalars, or failed signature verification.
pub proc verify_prehash
    exec.ecdsa_secp256k1::assert_verify_prehash
end

#! Compresses a native affine secp256k1 public key into compressed SEC1 packed-felt form.
#!
#! Input:  [pubkey_ptr, out_ptr, ...]
#! Output: [out_ptr + 9, ...]
#!
#! Memory:
#! - `pubkey_ptr[0..8]`: QX as little-endian u32 limbs.
#! - `pubkey_ptr[8..16]`: QY as little-endian u32 limbs.
#! - `out_ptr[0..9]`: receives PK[0..9], the compressed SEC1 encoding `prefix || x_be`
#!   packed into 9 little-endian packed-u32 felts.
#!
#! Where `prefix = 2 + (QY0 & 1)`. The input and output ranges must not overlap.
#! The procedure expects all consumed QX limbs and QY0 to be valid u32 values.
pub proc compress_public_key
    # Compute the SEC1 compression prefix from the least-significant bit of Y.
    dup add.8 mem_load
    # => [QY0, pubkey_ptr, out_ptr, ...]
    u32and.1 add.2
    # => [prefix=2+(QY0&1), pubkey_ptr, out_ptr, ...]

    # PK0 contains the prefix followed by the three most-significant bytes of X.
    dup.1 add.7 mem_load
    # => [QX7, prefix, pubkey_ptr, out_ptr, ...]
    exec.pack_sec1_first_word
    # => [PK0, pubkey_ptr, out_ptr, ...]
    dup.2 mem_store
    # => [pubkey_ptr, out_ptr, ...]

    # Store PK[1..8) while walking X from low-to-high limbs and the output backward from PK7.
    swap add.7 swap
    # => [src_ptr=pubkey_ptr, dst_ptr=out_ptr+7, ...]
    repeat.7
        exec.pack_sec1_middle_word_from_mem
    end
    # => [src_ptr=pubkey_ptr+7, dst_ptr=out_ptr, ...]

    # PK8 is the remaining least-significant byte of X.
    dup sub.7 mem_load
    # => [QX0, src_ptr=pubkey_ptr+7, dst_ptr=out_ptr, ...]
    u32and.255
    # => [PK8, src_ptr=pubkey_ptr+7, dst_ptr=out_ptr, ...]
    dup.2 add.8 mem_store
    # => [src_ptr=pubkey_ptr+7, dst_ptr=out_ptr, ...]

    drop add.9
    # => [out_ptr+9, ...]
end

# INTERNAL PROCEDURES — PUBLIC-KEY COMPRESSION
# ================================================================================================

#! Packs the first compressed SEC1 word.
#!
#! Input:  [QX7, prefix, ...]
#! Output: [prefix | byte3(QX7)<<8 | byte2(QX7)<<16 | byte1(QX7)<<24, ...]
#!
#! Preconditions: QX7 is a u32 value. `byte_i(x) = (x >> 8*i) & 0xff`.
proc pack_sec1_first_word
    dup u32shr.16 u32and.65280
    # => [byte3(QX7)<<8, QX7, prefix, ...]
    movup.2 add
    # => [prefix | byte3(QX7)<<8, QX7, ...]

    swap dup u32and.16711680
    # => [byte2(QX7)<<16, QX7, acc, ...]
    movup.2 add
    # => [acc | byte2(QX7)<<16, QX7, ...]

    swap u32and.65280 mul.65536
    # => [byte1(QX7)<<24, acc, ...]
    add
    # => [PK0, ...]
end

#! Packs one middle compressed SEC1 word.
#!
#! Input:  [A, B, ...]
#! Output: [byte0(A) | byte3(B)<<8 | byte2(B)<<16 | byte1(B)<<24, ...]
#!
#! Preconditions: A and B are u32 values. `byte_i(x) = (x >> 8*i) & 0xff`.
proc pack_sec1_middle_word
    u32and.255
    # => [byte0(A), B, ...]

    swap
    # => [B, byte0(A), ...]
    dup u32shr.16 u32and.65280
    # => [byte3(B)<<8, B, byte0(A), ...]
    movup.2 add
    # => [byte0(A) | byte3(B)<<8, B, ...]

    swap dup u32and.16711680
    # => [byte2(B)<<16, B, acc, ...]
    movup.2 add
    # => [acc | byte2(B)<<16, B, ...]

    swap u32and.65280 mul.65536
    # => [byte1(B)<<24, acc, ...]
    add
    # => [PK_WORD, ...]
end

#! Loads and packs one middle compressed SEC1 word, stores it, and advances pointers.
#!
#! Input:  [src_ptr, dst_ptr, ...]
#! Output: [src_ptr+1, dst_ptr-1, ...]
#!
#! Memory:
#! - src_ptr[0] = B, src_ptr[1] = A
#! - dst_ptr receives byte0(A) | byte3(B)<<8 | byte2(B)<<16 | byte1(B)<<24
proc pack_sec1_middle_word_from_mem
    dup mem_load
    # => [B, src_ptr, dst_ptr, ...]
    dup.1 add.1 mem_load
    # => [A, B, src_ptr, dst_ptr, ...]
    exec.pack_sec1_middle_word
    # => [PK_WORD, src_ptr, dst_ptr, ...]

    dup.2 mem_store
    # => [src_ptr, dst_ptr, ...]
    add.1
    # => [src_ptr+1, dst_ptr, ...]
    swap sub.1 swap
    # => [src_ptr+1, dst_ptr-1, ...]
end

# INTERNAL PROCEDURES — MESSAGE PACKING
# ================================================================================================

#! Splits a word into the eight little-endian u32 limbs used as the 32-byte Keccak message.
#!
#! Input:  [w0, w1, w2, w3, ...]
#! Output: [w0_lo, w0_hi, w1_lo, w1_hi, w2_lo, w2_hi, w3_lo, w3_hi, ...]
proc split_word_u32s_le
    swap u32split
    # => [w1_lo, w1_hi, w0, w2, w3, ...]
    movup.2 u32split
    # => [w0_lo, w0_hi, w1_lo, w1_hi, w2, w3, ...]

    movup.4 u32split
    # => [w2_lo, w2_hi, w0_lo, w0_hi, w1_lo, w1_hi, w3, ...]
    movdn.5 movdn.5
    # => [w0_lo, w0_hi, w1_lo, w1_hi, w2_lo, w2_hi, w3, ...]

    movup.6 u32split
    # => [w3_lo, w3_hi, w0_lo, w0_hi, w1_lo, w1_hi, w2_lo, w2_hi, ...]
    movdn.7 movdn.7
    # => [w0_lo, w0_hi, w1_lo, w1_hi, w2_lo, w2_hi, w3_lo, w3_hi, ...]
end

#! Reverses the byte order of a u32 limb.
#!
#! Input:  [x, ...]
#! Output: [byte_reverse(x), ...]
proc reverse_u32_bytes
    dup u32shr.8 push.0x00FF00FF u32and
    # => [(x >> 8) & 0x00ff00ff, x, ...]
    swap push.0x00FF00FF u32and mul.256
    # => [(x & 0x00ff00ff) << 8, shifted, ...]
    u32xor
    # => [x with adjacent bytes swapped, ...]

    dup u32shr.16
    # => [x >> 16, x, ...]
    swap u32shl.16
    # => [(x << 16) mod 2^32, x >> 16, ...]
    u32xor
    # => [byte_reverse(x), ...]
end
